# 광고·알림 기능 플래그. 기본값은 꺼짐이며 'true'일 때만 켜진다
VITE_ADS_ENABLED=false
VITE_NOTIFICATION_ENABLED=false

# 운영 광고 그룹 ID. 비워 두면 테스트 ID(ait-ad-test-banner-id)를 쓴다.
# 실제 값은 저장소에 넣지 않고 제출용 빌드에서만 .env.production.local에 적는다
VITE_AD_GROUP_ID_SUBJECTS=
VITE_AD_GROUP_ID_SESSION_DONE=

# 콘솔 스마트발송 템플릿 코드. 비워 두면 알림 동의 버튼을 숨긴다
VITE_NOTIFICATION_TEMPLATE_CODE=

# 테스트 빌드 전용 데모 데이터(설정의 "데모 데이터 채우기"). 출시 빌드에서는 켜지 않는다
VITE_DEMO_DATA=false
